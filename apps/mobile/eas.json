{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.20.0",
      "pnpm": "12.11.2",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.hazalang.com",
        "EXPO_PUBLIC_ORGANIZATION_SLUG": "hazalang",
        "EXPO_PUBLIC_BRAND_NAME": "HZ Worker",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "8a58d784-cfab-43c1-9bea-6984912a1a6d",
        "EXPO_ANDROID_PACKAGE": "com.hazalang.worker",
        "EXPO_IOS_BUNDLE_IDENTIFIER": "com.hazalang.worker"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
