{
  "name": "@ops/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Worker mobile app (Expo / React Native). Runs in Expo Go during development.",
  "main": "index.ts",
  "scripts": {
    "dev": "dotenv -e ../../.env -- expo start",
    "android": "dotenv -e ../../.env -- expo start --android",
    "ios": "dotenv -e ../../.env -- expo start --ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@ops/shared": "workspace:*",
    "expo": "~57.0.28",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@ops/config": "workspace:*",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.12.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  }
}
