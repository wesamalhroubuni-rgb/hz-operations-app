{
  "name": "@ops/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Worker mobile app (Expo / React Native). Runs in Expo Go during development.",
  "main": "index.ts",
  "scripts": {
    "dev": "dotenv -e ../../.env -- expo start --go",
    "dev:client": "dotenv -e ../../.env -- expo start --dev-client",
    "android": "dotenv -e ../../.env -- expo start --go --android",
    "ios": "dotenv -e ../../.env -- expo start --go --ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "eas-build-post-install": "pnpm --filter @ops/shared build"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.2",
    "@ops/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/elements": "2.9.45",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@tanstack/react-query": "5.104.3",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ops/config": "workspace:*",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.12.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  }
}
