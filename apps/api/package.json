{
  "name": "@ops/api",
  "version": "0.1.0",
  "private": true,
  "description": "Operations App REST API (NestJS + Prisma + PostgreSQL).",
  "scripts": {
    "postinstall": "prisma generate --no-hints",
    "dev": "prisma generate --no-hints && dotenv -e ../../.env -- nest start --watch",
    "build": "prisma generate --no-hints && nest build",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "lint": "eslint .",
    "typecheck": "prisma generate --no-hints && tsc --noEmit",
    "test": "prisma generate --no-hints && node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "db:generate": "prisma generate --no-hints",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@ops/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@ops/config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "prisma": "7.10.0",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3"
  }
}
