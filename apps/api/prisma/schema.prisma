// Prisma schema for the API.
// The connection URL is supplied by prisma.config.ts (Prisma 7), not by this file.
//
// Conventions:
// - Every business record carries organizationId (multi-tenant-ready; one tenant in use today).
// - Users, sites, teams, memberships, log types, tasks, work logs and attachments are archived
//   (archivedAt), never deleted, so history and the audit trail stay intact.
// - AuditEvent and OutboxEvent are platform tables: no foreign keys to business tables, and
//   AuditEvent is append-only (enforced by a trigger in the first migration).
// See docs/decisions/0002 and 0003 for the reasoning.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  worker
  supervisor
  manager
  admin
}

enum TaskStatus {
  todo
  in_progress
  blocked
  done
  cancelled
}

enum TaskPriority {
  low
  normal
  high
  urgent
}

enum WorkLogStatus {
  draft
  submitted
  approved
  rejected
}

/// How a work log was captured. Everything is `manual` until the AI phases.
enum WorkLogSource {
  manual
  voice
  photo
  ai
}

enum AttachmentStatus {
  pending
  ready
}

enum PushPlatform {
  ios
  android
}

enum AuditActorType {
  user
  system
}

// ---------------------------------------------------------------------------
// Organization structure
// ---------------------------------------------------------------------------

/// The tenant. Every business record belongs to exactly one organization.
model Organization {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String
  slug       String    @unique
  /// Organization settings, validated by `organizationSettingsSchema` in @ops/shared:
  /// workLogEditWindowHours, offlineMaxBackdateDays, timeZone (IANA, default Europe/Istanbul,
  /// Phase 6), plus any other key kept as it is.
  settings   Json      @default("{}")
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)

  users       User[]
  sites       Site[]
  teams       Team[]
  memberships Membership[]
  logTypes    LogType[]
  tasks       Task[]
  workLogs    WorkLog[]
  attachments Attachment[]
}

model User {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  /// Login identifiers. A user has at least one of email, phone, username (enforced by the API);
  /// each is unique within the organization. Stored normalized: email and username lower-case,
  /// phone as digits with an optional leading +.
  email          String?
  phone          String?
  username       String?
  displayName    String
  /// The user's language (`SUPPORTED_LOCALES` in @ops/shared: en, tr, ar). The apps and the
  /// server-rendered notification text use it (Phase 6, ADR-0009).
  locale         String    @default("en")
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt     DateTime? @db.Timestamptz(3)

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships     Membership[]
  createdTasks    Task[]         @relation("TaskCreatedBy")
  taskAssignments TaskAssignee[]
  workLogs        WorkLog[]
  attachments     Attachment[]

  @@unique([organizationId, email])
  @@unique([organizationId, phone])
  @@unique([organizationId, username])
  @@index([organizationId, archivedAt])
}

/// A physical location or project. Optional hierarchy through parentId.
model Site {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  parentId       String?   @db.Uuid
  name           String
  code           String?
  description    String?
  address        String?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt     DateTime? @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       Site?            @relation("SiteHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Site[]           @relation("SiteHierarchy")
  memberships  MembershipSite[]
  tasks        Task[]
  workLogs     WorkLog[]

  @@unique([organizationId, code])
  @@index([organizationId, archivedAt])
  @@index([organizationId, parentId])
}

/// A group of people. Optional hierarchy through parentId.
model Team {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  parentId       String?   @db.Uuid
  name           String
  description    String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt     DateTime? @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       Team?            @relation("TeamHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Team[]           @relation("TeamHierarchy")
  memberships  MembershipTeam[]
  tasks        Task[]
  workLogs     WorkLog[]

  @@index([organizationId, archivedAt])
  @@index([organizationId, parentId])
}

/// A role held by a user, with a scope: the whole organization (orgWide), any number of sites,
/// and/or any number of teams. Site and team scopes are a union, not an intersection. A user may
/// hold several memberships (different roles in different scopes).
model Membership {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  role           Role
  orgWide        Boolean   @default(false)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt     DateTime? @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  sites        MembershipSite[]
  teams        MembershipTeam[]

  @@index([organizationId, userId])
  @@index([organizationId, role])
}

model MembershipSite {
  membershipId   String @db.Uuid
  siteId         String @db.Uuid
  organizationId String @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  site       Site       @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@id([membershipId, siteId])
  @@index([organizationId, siteId])
}

model MembershipTeam {
  membershipId   String @db.Uuid
  teamId         String @db.Uuid
  organizationId String @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@id([membershipId, teamId])
  @@index([organizationId, teamId])
}

// ---------------------------------------------------------------------------
// Work data
// ---------------------------------------------------------------------------

/// A kind of work log configurable per organization ("Inspection", "Delivery", ...).
/// `fields` is an ordered array of custom field definitions (see @ops/shared). `version` is
/// incremented whenever `fields` changes; each work log records the version it was validated
/// against.
model LogType {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  key            String
  name           String
  description    String?
  fields         Json      @default("[]")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt     DateTime? @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workLogs     WorkLog[]

  @@unique([organizationId, key])
  @@index([organizationId, archivedAt])
}

model Task {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  title          String
  description    String?
  status         TaskStatus   @default(todo)
  priority       TaskPriority @default(normal)
  siteId         String?      @db.Uuid
  teamId         String?      @db.Uuid
  createdById    String       @db.Uuid
  dueAt          DateTime?    @db.Timestamptz(3)
  completedAt    DateTime?    @db.Timestamptz(3)
  /// Why the task has its current status, when that needs saying (required for `blocked`).
  /// Cleared on every status change that gives none.
  statusReason   String?
  /// Optimistic-concurrency counter (ADR-0008): 1 on create, +1 on every change of the row,
  /// its status or its assignees (and on archive/restore). Clients send it back as
  /// `expectedVersion`; a mismatch is a 409 `version_conflict`.
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  archivedAt     DateTime?    @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site?          @relation(fields: [siteId], references: [id], onDelete: Restrict)
  team         Team?          @relation(fields: [teamId], references: [id], onDelete: Restrict)
  createdBy    User           @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignees    TaskAssignee[]
  workLogs     WorkLog[]

  @@index([organizationId, status])
  @@index([organizationId, siteId])
  @@index([organizationId, teamId])
  @@index([organizationId, dueAt])
  @@index([organizationId, createdAt])
}

model TaskAssignee {
  taskId         String   @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  assignedAt     DateTime @default(now()) @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([taskId, userId])
  @@index([organizationId, userId])
}

/// A worker's entry. `occurredAt` is when the work happened; `createdAt` is when the server
/// stored it (they differ once offline sync exists). `clientId` is generated on the device so a
/// retried upload is idempotent.
model WorkLog {
  id               String        @id @default(uuid(7)) @db.Uuid
  organizationId   String        @db.Uuid
  clientId         String        @db.Uuid
  authorId         String        @db.Uuid
  occurredAt       DateTime      @db.Timestamptz(3)
  taskId           String?       @db.Uuid
  siteId           String?       @db.Uuid
  teamId           String?       @db.Uuid
  logTypeId        String?       @db.Uuid
  /// LogType.version the custom fields were validated against.
  logTypeVersion   Int?
  text             String?
  /// Custom field values keyed by field key, validated against the log type's definition.
  customFields     Json          @default("{}")
  latitude         Float?
  longitude        Float?
  /// GPS accuracy radius in metres.
  locationAccuracy Float?
  status           WorkLogStatus @default(submitted)
  /// Who approved or rejected the log last, when, and the note they gave (the rejection reason).
  /// Cleared when the log goes back to submitted.
  reviewedById     String?       @db.Uuid
  reviewedAt       DateTime?     @db.Timestamptz(3)
  reviewNote       String?
  source           WorkLogSource @default(manual)
  /// Reserved for AI-derived data (Phase 7). Always null today.
  aiMetadata       Json?
  /// Optimistic-concurrency counter (ADR-0008): 1 on create, +1 on every change (content,
  /// status, review, archive). Clients send it back as `expectedVersion`.
  version          Int           @default(1)
  /// The create request carried `X-Client-Sync: offline`: the log was written on the phone
  /// without a connection and sent later by the sync queue (ADR-0008).
  submittedOffline Boolean       @default(false)
  /// The phone's clock when the worker saved the log (body field `deviceCreatedAt`).
  /// Informative only: never used by a rule.
  deviceCreatedAt  DateTime?     @db.Timestamptz(3)
  /// Phone clock minus server clock, in whole seconds, measured from the `X-Device-Time`
  /// header of the create request. Null when the header was absent. A magnitude above
  /// CLOCK_SKEW_FLAG_SECONDS (@ops/shared) is flagged to reviewers.
  clockSkewSeconds Int?
  /// The attachment clientIds declared in the create request (`attachmentClientIds`): the
  /// photos that are "part of the original submission" and may still be uploaded by the author
  /// after the edit window (ADR-0008). Never changed after create.
  declaredAttachmentClientIds String[] @default([]) @db.Uuid
  /// The server receive time. For a log created offline it is when the sync reached the
  /// server; the edit window counts from it.
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  archivedAt       DateTime?     @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Restrict)
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: Restrict)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: Restrict)
  logType      LogType?     @relation(fields: [logTypeId], references: [id], onDelete: Restrict)
  attachments  Attachment[]

  @@unique([organizationId, clientId])
  @@index([organizationId, occurredAt])
  @@index([organizationId, authorId, occurredAt])
  @@index([organizationId, siteId, occurredAt])
  @@index([organizationId, teamId, occurredAt])
  @@index([organizationId, status])
  @@index([organizationId, taskId])
  @@index([organizationId, logTypeId])
}

/// Metadata of a file attached to a work log. The bytes live behind the storage interface
/// (Phase 4); only the key is stored here.
model Attachment {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @db.Uuid
  workLogId      String           @db.Uuid
  uploadedById   String           @db.Uuid
  /// Generated on the device (ADR-0008). Starting an upload again with the same clientId returns
  /// this attachment instead of creating another; somebody else's clientId is a 409. Null for
  /// uploads started without one (web, older clients).
  clientId       String?          @db.Uuid
  fileName       String
  mimeType       String
  /// Declared by the client when the upload starts; replaced by the stored size on completion.
  sizeBytes      Int
  /// Chosen by the API, never by the client.
  storageKey     String
  /// `pending` until the client has uploaded the bytes and the API has verified them.
  status         AttachmentStatus @default(pending)
  /// Key of the small preview generated by the API on completion.
  thumbnailKey   String?
  width          Int?
  height         Int?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?        @db.Timestamptz(3)
  archivedAt     DateTime?        @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workLog      WorkLog      @relation(fields: [workLogId], references: [id], onDelete: Restrict)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, storageKey])
  @@unique([organizationId, clientId])
  @@index([organizationId, workLogId])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Platform tables (reusable across Kaneri products; no foreign keys to business tables)
// ---------------------------------------------------------------------------

/// Append-only record of who did what. Rows are never updated or deleted (database trigger).
model AuditEvent {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String?        @db.Uuid
  actorType      AuditActorType
  /// The acting user's id, or null when actorType is `system`.
  actorId        String?
  /// Dotted action name, for example "work_log.created".
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  /// Field-level diff: { field: { from, to } }. Null on create and when nothing is comparable.
  changes        Json?
  correlationId  String?
  /// How the change reached the API, set by the platform from the request headers (ADR-0008):
  /// `{ via: 'offline_sync', deviceTime, serverTime, clockSkewSeconds }` for a write sent by
  /// the phone's offline queue. Null for an ordinary request.
  metadata       Json?
  occurredAt     DateTime       @default(now()) @db.Timestamptz(3)

  @@index([organizationId, occurredAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorId, occurredAt])
  @@index([organizationId, action, occurredAt])
  @@index([correlationId])
}

/// Domain events written in the same transaction as the change they describe. Consumers
/// (the AI layer in Phase 7) read them in `sequence` order.
model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  sequence       BigInt    @unique @default(autoincrement())
  organizationId String?   @db.Uuid
  /// Dotted event name, for example "task.status_changed".
  eventType      String
  aggregateType  String
  aggregateId    String
  payload        Json
  actorId        String?
  correlationId  String?
  occurredAt     DateTime  @default(now()) @db.Timestamptz(3)
  /// Set by a consumer once handled. Nothing sets it yet.
  processedAt    DateTime? @db.Timestamptz(3)

  @@index([organizationId, sequence])
  @@index([organizationId, eventType, sequence])
  @@index([aggregateType, aggregateId])
  @@index([processedAt, sequence])
}

// ---------------------------------------------------------------------------
// Authentication (platform tables; no foreign keys to business tables)
// Nothing here stores a password, a code or a token in clear: only hashes.
// ---------------------------------------------------------------------------

enum AuthCodePurpose {
  activation
  password_reset
}

enum AuthClient {
  web
  mobile
}

/// The password of a user, and the state of the lockout after repeated failures.
/// A user without a row has not been activated yet and cannot sign in.
model AuthCredential {
  userId            String    @id @db.Uuid
  organizationId    String    @db.Uuid
  /// argon2id, in the PHC string format (parameters and salt included).
  passwordHash      String
  passwordChangedAt DateTime  @default(now()) @db.Timestamptz(3)
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime? @db.Timestamptz(3)
  lastLoginAt       DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@index([organizationId])
}

/// A one-time, expiring code that lets a user set a password (activation or reset).
model AuthOneTimeCode {
  id             String          @id @default(uuid(7)) @db.Uuid
  userId         String          @db.Uuid
  organizationId String          @db.Uuid
  purpose        AuthCodePurpose
  /// SHA-256 of the code. The code itself is shown once and never stored.
  codeHash       String          @unique
  expiresAt      DateTime        @db.Timestamptz(3)
  consumedAt     DateTime?       @db.Timestamptz(3)
  /// The admin who issued it, or null for the system (seed).
  issuedById     String?         @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
}

/// One sign-in on one device: the "family" of refresh tokens that replace each other.
/// Revoking the session invalidates every token of the family at once.
model AuthSession {
  id             String     @id @default(uuid(7)) @db.Uuid
  userId         String     @db.Uuid
  organizationId String     @db.Uuid
  client         AuthClient
  deviceName     String?
  userAgent      String?
  ipAddress      String?
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  lastUsedAt     DateTime   @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime   @db.Timestamptz(3)
  revokedAt      DateTime?  @db.Timestamptz(3)
  /// Why it ended: logout, logout_all, refresh_reuse, user_archived, membership_removed,
  /// password_changed, admin_revoked, expired.
  revokedReason  String?

  refreshTokens AuthRefreshToken[]

  @@index([userId, revokedAt])
  @@index([organizationId, userId])
  @@index([expiresAt])
}

/// A refresh token of a session. Each one is used once and replaced (rotation). Presenting a
/// token whose `usedAt` is set means it was stolen or replayed: the whole session is revoked.
model AuthRefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @db.Uuid
  /// SHA-256 of the token.
  tokenHash String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// Notifications (platform tables; no foreign keys to business tables)
// ---------------------------------------------------------------------------

/// A message shown in a user's in-app notification list. Created by the notification service,
/// usually from an outbox event; `sourceEventId` makes that idempotent.
model Notification {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  recipientId    String    @db.Uuid
  /// Dotted kind, e.g. "task.assigned", "work_log.approved".
  type           String
  title          String
  body           String
  /// What the client needs to open the right screen, e.g. { taskId } or { workLogId }.
  data           Json      @default("{}")
  /// The outbox event this notification was made from, if any.
  sourceEventId  String?   @db.Uuid
  readAt         DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([sourceEventId, recipientId, type])
  @@index([organizationId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

/// A device that may receive push notifications for a user, tied to the session it registered
/// with: ending the session removes it.
model PushToken {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  sessionId      String?      @db.Uuid
  /// The Expo push token ("ExponentPushToken[...]").
  token          String       @unique
  platform       PushPlatform
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([sessionId])
}

/// How far a named consumer has read the outbox (consumers read in `sequence` order).
model OutboxConsumerCursor {
  consumer     String   @id
  lastSequence BigInt   @default(0)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

// ---------------------------------------------------------------------------
// Idempotency (platform table; no foreign keys to business tables). ADR-0008.
// ---------------------------------------------------------------------------

/// One `Idempotency-Key` used by one user on a route marked idempotent. The first request
/// claims the key (`statusCode` null while it runs); a repeat with the same request hash
/// replays the stored status and body; a repeat with another hash is a 422
/// `idempotency_key_reused`; a repeat while the first still runs is a 409
/// `request_in_progress` until `lockedUntil`, after which it may take over. Rows are deleted
/// after `expiresAt` (14 days). The stored body may hold personal data and is only ever
/// returned to the same user.
model IdempotencyRecord {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  /// The client's key (a UUID).
  key            String    @db.Uuid
  method         String
  /// The request path without the query string.
  path           String
  /// SHA-256 (hex) of the method, the path and the canonical JSON body.
  requestHash    String
  /// Null while the first request runs; the stored HTTP status afterwards.
  statusCode     Int?
  responseBody   Json?
  lockedUntil    DateTime  @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  completedAt    DateTime? @db.Timestamptz(3)
  expiresAt      DateTime  @db.Timestamptz(3)

  @@unique([organizationId, userId, key])
  @@index([expiresAt])
}
