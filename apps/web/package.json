{
  "name": "@ops/web",
  "version": "0.1.0",
  "private": true,
  "description": "Manager dashboard for the Operations App (Next.js).",
  "scripts": {
    "dev": "dotenv -e ../../.env -- node scripts/next.mjs dev",
    "build": "dotenv -e ../../.env -- node scripts/next.mjs build",
    "start": "dotenv -e ../../.env -- node scripts/next.mjs start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ops/shared": "workspace:*",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-table": "8.21.3",
    "leaflet": "1.9.4",
    "next": "~16.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ops/config": "workspace:*",
    "@types/leaflet": "1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "~16.4.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
