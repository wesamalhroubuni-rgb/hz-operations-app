{
  "name": "@ops/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types and Zod validation schemas used by the API, web, and mobile apps.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ops/config": "workspace:*",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
