# Copy this file to .env (same folder) and adjust values for your machine.
# .env is git-ignored. Never commit real secrets.
# Every app loads this single root .env through dotenv-cli in its package scripts.

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=ops
# Local development only. Use a strong secret anywhere else.
POSTGRES_PASSWORD=change_me_local_dev_only
POSTGRES_DB=operations_app
POSTGRES_PORT=5432

# --- API (apps/api) ---
# Must match the PostgreSQL values above.
DATABASE_URL=postgresql://ops:change_me_local_dev_only@localhost:5432/operations_app?schema=public
# How long (milliseconds) the API waits for a database connection before giving up.
DATABASE_CONNECT_TIMEOUT_MS=5000
# 127.0.0.1 = reachable from this PC only. Keep it that way while DEV_AUTH_ENABLED is true:
# with the dev header, anyone who can reach the API can act as any user. Use 0.0.0.0 only for a
# phone test on a network you trust.
API_HOST=127.0.0.1
API_PORT=3001
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=log
# TEMPORARY, development only (removed in Phase 3): lets a caller act as any user by sending the
# x-dev-user-id header. The API refuses to start if this is true outside NODE_ENV=development.
# NODE_ENV is set by the package scripts (dev = development, start = production), not here.
DEV_AUTH_ENABLED=true
# Separate database for the API integration tests (pnpm test:integration). Never the dev database.
DATABASE_URL_TEST=postgresql://ops:change_me_local_dev_only@localhost:5432/operations_app_test?schema=public

# --- Web dashboard (apps/web) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# Client/product name shown in the dashboard. The same codebase can be deployed for other clients.
NEXT_PUBLIC_BRAND_NAME=HZ

# --- Mobile app (apps/mobile) ---
# A phone cannot reach "localhost" on your PC. Replace it with your PC's
# Wi-Fi IP address (run `ipconfig`), for example http://192.168.1.20:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
# Client/product name shown in the mobile app (also used for the app name on the device).
EXPO_PUBLIC_BRAND_NAME=HZ
