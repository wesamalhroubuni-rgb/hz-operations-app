# Copy this file to .env (same folder) and adjust values for your machine.
# .env is git-ignored. Never commit real secrets.
# Every app loads this single root .env through dotenv-cli in its package scripts.

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=ops
# Local development only. Use a strong secret anywhere else.
POSTGRES_PASSWORD=change_me_local_dev_only
POSTGRES_DB=operations_app
POSTGRES_PORT=5432

# --- API (apps/api) ---
# Must match the PostgreSQL values above.
DATABASE_URL=postgresql://ops:change_me_local_dev_only@localhost:5432/operations_app?schema=public
# How long (milliseconds) the API waits for a database connection before giving up.
DATABASE_CONNECT_TIMEOUT_MS=5000
# Separate database for the API integration tests (pnpm test:integration). Never the dev database.
DATABASE_URL_TEST=postgresql://ops:change_me_local_dev_only@localhost:5432/operations_app_test?schema=public
# 127.0.0.1 = reachable from this PC only. Use 0.0.0.0 to reach the API from a phone on a
# network you trust.
API_HOST=127.0.0.1
API_PORT=3001
# Comma-separated list of origins allowed to call the API from a browser. The same list is the
# allow-list of the CSRF check: a cookie-authenticated write from any other origin is refused.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=log
# How many reverse proxies sit in front of the API. 0 (no proxy) in development. Behind a proxy
# or load balancer set the exact number, so per-IP rate limits see the real client address.
TRUST_PROXY_HOPS=0
# NODE_ENV is set by the package scripts (dev = development, start = production), not here.

# --- Sign-in (apps/api) ---
# Signs access tokens and derives the CSRF key. At least 32 characters.
# DEVELOPMENT-ONLY PLACEHOLDER: the API refuses to start in production with this value.
# Generate a real one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_ACCESS_TOKEN_SECRET=dev_only_placeholder_change_me_before_any_real_use
# Lifetime of an access token (seconds).
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# A session ends after this many days without use, and after the absolute limit at the latest.
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_SESSION_ABSOLUTE_TTL_DAYS=90
# A refresh token sent twice within this many seconds (two browser tabs) does not end the session.
AUTH_REFRESH_REUSE_GRACE_SECONDS=10
# Validity of the one-time codes: activation (hours) and password reset (minutes).
AUTH_ACTIVATION_CODE_TTL_HOURS=72
AUTH_RESET_CODE_TTL_MINUTES=60
# Lockout: after this many failed sign-ins in a row, the account is locked for this many minutes.
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
# Domain attribute of the session cookies. Leave empty unless the web app and the API are on
# different subdomains of one domain (then: that parent domain, for example example.com).
AUTH_COOKIE_DOMAIN=
# Public address of the web app. Activation and reset links point at it. https in production.
WEB_APP_URL=http://localhost:3000

# --- File storage (S3-compatible; MinIO in Docker Compose for development) ---
# MinIO's own login (development only). The API uses the STORAGE_* keys below.
MINIO_ROOT_USER=hz_minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_local_dev_only
# 127.0.0.1 = reachable from this PC only. For a phone test set 0.0.0.0 (see README), then back.
MINIO_BIND_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Where the API reaches the storage (server to server).
STORAGE_ENDPOINT=http://127.0.0.1:9000
# The address put into signed upload/download URLs: must be reachable by the phone or browser.
# For a phone test: http://<PC hotspot IP>:9000. https in production.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=hz-attachments
# Development only: the same as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD. Use a scoped key elsewhere.
STORAGE_ACCESS_KEY_ID=hz_minio_admin
STORAGE_SECRET_ACCESS_KEY=change_me_minio_local_dev_only
STORAGE_FORCE_PATH_STYLE=true
# Largest photo accepted, in bytes (10 MiB). Signed URLs live this many seconds.
UPLOAD_MAX_BYTES=10485760
UPLOAD_URL_TTL_SECONDS=300
DOWNLOAD_URL_TTL_SECONDS=300

# --- Notifications ---
# Optional: only needed when "enhanced push security" is enabled for the Expo project.
EXPO_ACCESS_TOKEN=
PUSH_ENABLED=true
OUTBOX_CONSUMER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=2000

# --- Web dashboard (apps/web) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# Client/product name shown in the dashboard. The same codebase can be deployed for other clients.
NEXT_PUBLIC_BRAND_NAME=HZ
# Slug of the organization this deployment serves; sent with every sign-in. The API refuses a
# sign-in without it as soon as more than one organization exists.
NEXT_PUBLIC_ORGANIZATION_SLUG=hz-demo

# --- Mobile app (apps/mobile) ---
# A phone cannot reach "localhost" on your PC. Replace it with your PC's
# Wi-Fi IP address (run `ipconfig`), for example http://192.168.1.20:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
# Client/product name shown in the mobile app (also used for the app name on the device).
EXPO_PUBLIC_BRAND_NAME=HZ
# Same as NEXT_PUBLIC_ORGANIZATION_SLUG, for the mobile app.
EXPO_PUBLIC_ORGANIZATION_SLUG=hz-demo
# EAS project id of your Expo account (from `eas init`): needed for push notifications in a
# development build. Leave empty to run without push (the in-app list still works).
EXPO_PUBLIC_EAS_PROJECT_ID=
# App identifiers for development and store builds (empty = ai.kaneri.operations). Decide the final
# ones before the first store build; they cannot change after publishing.
EXPO_IOS_BUNDLE_IDENTIFIER=
EXPO_ANDROID_PACKAGE=
