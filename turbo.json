{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_CONNECT_TIMEOUT_MS",
    "API_HOST",
    "API_PORT",
    "CORS_ORIGINS",
    "LOG_LEVEL",
    "WEB_PORT",
    "NEXT_PUBLIC_API_URL",
    "EXPO_PUBLIC_API_URL",
    "NODE_ENV",
    "AUTH_ACCESS_TOKEN_SECRET",
    "AUTH_ACCESS_TOKEN_TTL_SECONDS",
    "AUTH_REFRESH_TOKEN_TTL_DAYS",
    "AUTH_SESSION_ABSOLUTE_TTL_DAYS",
    "AUTH_REFRESH_REUSE_GRACE_SECONDS",
    "AUTH_ACTIVATION_CODE_TTL_HOURS",
    "AUTH_RESET_CODE_TTL_MINUTES",
    "AUTH_MAX_FAILED_LOGINS",
    "AUTH_LOCKOUT_MINUTES",
    "AUTH_COOKIE_DOMAIN",
    "WEB_APP_URL",
    "DATABASE_URL_TEST",
    "NEXT_PUBLIC_BRAND_NAME",
    "EXPO_PUBLIC_BRAND_NAME",
    "TRUST_PROXY_HOPS",
    "NEXT_PUBLIC_ORGANIZATION_SLUG",
    "EXPO_PUBLIC_ORGANIZATION_SLUG"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
