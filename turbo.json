{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_CONNECT_TIMEOUT_MS",
    "API_HOST",
    "API_PORT",
    "CORS_ORIGINS",
    "LOG_LEVEL",
    "WEB_PORT",
    "NEXT_PUBLIC_API_URL",
    "EXPO_PUBLIC_API_URL",
    "NODE_ENV",
    "AUTH_ACCESS_TOKEN_SECRET",
    "AUTH_ACCESS_TOKEN_TTL_SECONDS",
    "AUTH_REFRESH_TOKEN_TTL_DAYS",
    "AUTH_SESSION_ABSOLUTE_TTL_DAYS",
    "AUTH_REFRESH_REUSE_GRACE_SECONDS",
    "AUTH_ACTIVATION_CODE_TTL_HOURS",
    "AUTH_RESET_CODE_TTL_MINUTES",
    "AUTH_MAX_FAILED_LOGINS",
    "AUTH_LOCKOUT_MINUTES",
    "AUTH_COOKIE_DOMAIN",
    "WEB_APP_URL",
    "DATABASE_URL_TEST",
    "NEXT_PUBLIC_BRAND_NAME",
    "EXPO_PUBLIC_BRAND_NAME",
    "TRUST_PROXY_HOPS",
    "NEXT_PUBLIC_ORGANIZATION_SLUG",
    "EXPO_PUBLIC_ORGANIZATION_SLUG",
    "STORAGE_ENDPOINT",
    "STORAGE_PUBLIC_ENDPOINT",
    "STORAGE_REGION",
    "STORAGE_BUCKET",
    "STORAGE_ACCESS_KEY_ID",
    "STORAGE_SECRET_ACCESS_KEY",
    "STORAGE_FORCE_PATH_STYLE",
    "UPLOAD_MAX_BYTES",
    "UPLOAD_URL_TTL_SECONDS",
    "DOWNLOAD_URL_TTL_SECONDS",
    "EXPO_ACCESS_TOKEN",
    "PUSH_ENABLED",
    "OUTBOX_CONSUMER_ENABLED",
    "OUTBOX_POLL_INTERVAL_MS",
    "EXPO_PUBLIC_EAS_PROJECT_ID",
    "EXPO_IOS_BUNDLE_IDENTIFIER",
    "EXPO_ANDROID_PACKAGE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
