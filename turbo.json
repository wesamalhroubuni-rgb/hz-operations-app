{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_CONNECT_TIMEOUT_MS",
    "API_HOST",
    "API_PORT",
    "CORS_ORIGINS",
    "LOG_LEVEL",
    "WEB_PORT",
    "NEXT_PUBLIC_API_URL",
    "EXPO_PUBLIC_API_URL",
    "NODE_ENV",
    "DEV_AUTH_ENABLED",
    "DATABASE_URL_TEST",
    "NEXT_PUBLIC_BRAND_NAME",
    "EXPO_PUBLIC_BRAND_NAME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
